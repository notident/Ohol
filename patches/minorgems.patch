diff -ruN -x '*.o' -x '*.dep' -x '*.dep2' -x Makefile -x Makefile.minorGems_dependencies -x '*.temp' -x '*.orig' a/network/emscripten/loopback.cpp b/network/emscripten/loopback.cpp
--- a/network/emscripten/loopback.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/network/emscripten/loopback.cpp	2026-11-22 22:51:15.871211287 +0000
@@ -0,0 +1,140 @@
+#include "loopback.h"
+
+#include <string.h>
+
+typedef struct Pipe {
+        SimpleVector<unsigned char> toEnd[2];   // data waiting for each end
+        char closed[2];
+        char used;
+    } Pipe;
+
+static SimpleVector<Pipe*> pipes;
+static SimpleVector<int> pendingAccepts;
+static char serverListening = false;
+
+
+void loopbackSetServerListening( char inListening ) {
+    serverListening = inListening;
+    }
+
+char loopbackIsServerListening() {
+    return serverListening;
+    }
+
+
+static Pipe *getPipe( int inID ) {
+    int p = inID / 2;
+    if( inID < 0 || p >= pipes.size() ) {
+        return NULL;
+        }
+    Pipe *pipe = pipes.getElementDirect( p );
+    if( ! pipe->used ) {
+        return NULL;
+        }
+    return pipe;
+    }
+
+
+int loopbackConnect() {
+    if( ! serverListening ) {
+        return -1;
+        }
+    Pipe *pipe = new Pipe;
+    pipe->closed[0] = false;
+    pipe->closed[1] = false;
+    pipe->used = true;
+
+    int index = -1;
+    for( int i=0; i<pipes.size(); i++ ) {
+        if( ! pipes.getElementDirect( i )->used ) {
+            delete pipes.getElementDirect( i );
+            *( pipes.getElement( i ) ) = pipe;
+            index = i;
+            break;
+            }
+        }
+    if( index == -1 ) {
+        pipes.push_back( pipe );
+        index = pipes.size() - 1;
+        }
+    pendingAccepts.push_back( index * 2 + 1 );
+    return index * 2;
+    }
+
+
+char loopbackHasPendingAccept() {
+    return pendingAccepts.size() > 0;
+    }
+
+int loopbackAccept() {
+    if( pendingAccepts.size() == 0 ) {
+        return -1;
+        }
+    int id = pendingAccepts.getElementDirect( 0 );
+    pendingAccepts.deleteElement( 0 );
+    return id;
+    }
+
+
+int loopbackSend( int inID, const unsigned char *inData, int inLength ) {
+    Pipe *pipe = getPipe( inID );
+    if( pipe == NULL ) {
+        return -1;
+        }
+    int me = inID & 1;
+    int other = 1 - me;
+    if( pipe->closed[me] || pipe->closed[other] ) {
+        return -1;
+        }
+    pipe->toEnd[other].appendArray( (unsigned char*)inData, inLength );
+    return inLength;
+    }
+
+
+int loopbackBytesAvailable( int inID ) {
+    Pipe *pipe = getPipe( inID );
+    if( pipe == NULL ) {
+        return 0;
+        }
+    return pipe->toEnd[ inID & 1 ].size();
+    }
+
+
+int loopbackReceive( int inID, unsigned char *inBuffer, int inMax ) {
+    Pipe *pipe = getPipe( inID );
+    if( pipe == NULL ) {
+        return -1;
+        }
+    int me = inID & 1;
+    int other = 1 - me;
+    SimpleVector<unsigned char> *q = &( pipe->toEnd[me] );
+    int n = q->size();
+    if( n == 0 ) {
+        if( pipe->closed[other] || pipe->closed[me] ) {
+            return -1;
+            }
+        return -2;
+        }
+    if( n > inMax ) {
+        n = inMax;
+        }
+    unsigned char *data = q->getElementArray();
+    memcpy( inBuffer, data, n );
+    delete [] data;
+    q->deleteStartElements( n );
+    return n;
+    }
+
+
+void loopbackClose( int inID ) {
+    Pipe *pipe = getPipe( inID );
+    if( pipe == NULL ) {
+        return;
+        }
+    pipe->closed[ inID & 1 ] = true;
+    if( pipe->closed[0] && pipe->closed[1] ) {
+        pipe->used = false;
+        pipe->toEnd[0].deleteAll();
+        pipe->toEnd[1].deleteAll();
+        }
+    }
diff -ruN -x '*.o' -x '*.dep' -x '*.dep2' -x Makefile -x Makefile.minorGems_dependencies -x '*.temp' -x '*.orig' a/network/emscripten/loopback.h b/network/emscripten/loopback.h
--- a/network/emscripten/loopback.h	1970-01-01 00:00:00.000000000 +0000
+++ b/network/emscripten/loopback.h	2026-11-22 22:51:15.869945860 +0000
@@ -0,0 +1,31 @@
+#ifndef LOOPBACK_INCLUDED
+#define LOOPBACK_INCLUDED
+
+// In-memory "network" for the browser build.  The client and the server
+// run in the same WebAssembly module, so a connection is just two byte
+// queues.  Socket ids are  pipeIndex*2 + end  (end 0 = client, 1 = server).
+
+#include "minorGems/util/SimpleVector.h"
+
+void loopbackSetServerListening( char inListening );
+char loopbackIsServerListening();
+
+// returns the client end id, or -1 if no server is listening.
+// the server end is queued for accept
+int loopbackConnect();
+
+// returns server end id of the next pending connection, or -1
+int loopbackAccept();
+char loopbackHasPendingAccept();
+
+// -1 if broken, otherwise number of bytes queued
+int loopbackSend( int inID, const unsigned char *inData, int inLength );
+
+// -1 if the other side closed and nothing is left to read,
+// -2 if nothing to read right now, otherwise bytes read (at most inMax)
+int loopbackReceive( int inID, unsigned char *inBuffer, int inMax );
+
+int loopbackBytesAvailable( int inID );
+void loopbackClose( int inID );
+
+#endif
