+extern void serverStep();
+
+static char started = false;
+static char failed = false;
+
+
+void embeddedServerStart() {
+    if( started ) {
+        return;
+        }
+    started = true;
+
+    const char *args[1] = { "OneLifeServer" };
+    int result = serverSetup( 1, args );
+
+    if( result != -1 ) {
+        failed = true;
+        }
+    }
+
+
+void embeddedServerFrame() {
+    if( started && ! failed ) {
+        serverStep();
+        }
+    }
