+
+    // email is owned by the new player; sock and buffer too
+    int id = processLoggedInPlayer( false, sock, buffer, email, 
+                                    (char*)"npc", 0, cs, ls, 1.0f,
+                                    NULL, -2, displayID, inPos, true );
+    
+    if( id < 0 ) {
+        delete link;
+        return -1;
+        }
+
+    NpcBrain b;
+    b.link = link;
+    b.id = id;
+    b.role = inRole;
+    b.momID = ( inRole == 0 ) ? id : inMomID;
+    b.nextThink = Time::getCurrentTime() + 2;
+    b.nextSay = Time::getCurrentTime() + 20;
+    LiveObject *p = getLiveObject( id );
+    b.homeX = p->xd;
+    b.homeY = p->yd;
+    npcBrains.push_back( b );
