+// Makes sure a living NPC mother (and father) exist.
+// Returns the mother's ID, or -1 if NPC family is disabled.
+// A human player who is born with this as inForceParentID becomes
+// the NPC mother's baby.
+static int npcEnsureFamily() {
+    if( ! SettingsManager::getIntSetting( "npcFamily", 1 ) ) {
+        return -1;
+        }
+
+    LiveObject *mom = findLiveNpcWithRole( 0 );
+
+    if( mom == NULL ) {
+        int momID = spawnNpc( 0, -1, NULL );
+        if( momID == -1 ) {
+            return -1;
+            }
+        mom = getLiveObject( momID );
+        }
+
+    LiveObject *dad = findLiveNpcWithRole( 1 );
+
+    if( dad == NULL ) {
+        GridPos p = { mom->xd + 3, mom->yd };
+        spawnNpc( 1, mom->id, &p );
+        }
+    return mom->id;
+    }
+
+
+// the server only allows actions on the same tile or on a tile directly
+// up, down, left or right (no diagonals), so use Manhattan distance
+static int npcCheb( int inDX, int inDY ) {
+    int a = inDX < 0 ? -inDX : inDX;
+    int b = inDY < 0 ? -inDY : inDY;
+    return a + b;
+    }
+
+
+// for real (human) logins: returns the NPC mother to be born to, or -1
+static int npcParentForLogin( int inTutorialNumber, char inReconnectOnly ) {
+    if( inTutorialNumber > 0 || inReconnectOnly ) {
+        return -1;
+        }
+    return npcEnsureFamily();
+    }
+
+
+static char npcBlocked( int inX, int inY ) {
+    return isMapSpotBlocking( inX, inY );
+    }
+
+
+// breadth-first search, 4-connected, within +/-10 of start.
+// goal = any cell within inGoalDist (Chebyshev) of target
+// that is walkable.  Fills outDeltas with cumulative offsets from the
+// start.  Returns number of steps (0 if none / already there).
+#define NPC_R 10
+static int npcFindPath( int inSX, int inSY, int inTX, int inTY, 
+                        int inGoalDist, int inMaxSteps,
+                        int *outDX, int *outDY ) {
+    const int W = 2 * NPC_R + 1;
+    static int prev[ W * W ];
+    static int queue[ W * W ];
+    
+    for( int i=0; i<W*W; i++ ) {
+        prev[i] = -2;
+        }
+    
+    int head = 0, tail = 0;
+    int startIdx = NPC_R * W + NPC_R;
+    prev[ startIdx ] = -1;
+    queue[ tail++ ] = startIdx;
+    
+    int goalIdx = -1;
+    int dx4[4] = { 1, -1, 0, 0 };
+    int dy4[4] = { 0, 0, 1, -1 };
+    
+    while( head < tail ) {
+        int cur = queue[ head++ ];
+        int cx = inSX + ( cur % W ) - NPC_R;
+        int cy = inSY + ( cur / W ) - NPC_R;
+        
+        int cd = npcCheb( cx - inTX, cy - inTY );
+        if( cd <= inGoalDist && ! ( cx == inTX && cy == inTY && 
+                                    inGoalDist > 0 ) ) {
+            goalIdx = cur;
+            break;
+            }
+        for( int d=0; d<4; d++ ) {
+            int nx = cx + dx4[d];
+            int ny = cy + dy4[d];
+            int ix = nx - inSX + NPC_R;
+            int iy = ny - inSY + NPC_R;
+            if( ix < 0 || iy < 0 || ix >= W || iy >= W ) {
+                continue;
+                }
+            int ni = iy * W + ix;
+            if( prev[ni] != -2 || npcBlocked( nx, ny ) ) {
+                continue;
+                }
+            prev[ni] = cur;
+            queue[ tail++ ] = ni;
+            }
+        }
+    
+    if( goalIdx == -1 || goalIdx == startIdx ) {
+        return 0;
+        }
+    
+    // walk back from goal to start, then reverse into forward order
+    int bx[ W * W ], by[ W * W ];
+    int k = 0;
+    for( int c = goalIdx; c != startIdx; c = prev[c] ) {
+        bx[k] = ( c % W ) - NPC_R;
+        by[k] = ( c / W ) - NPC_R;
+        k++;
+        }
+    int n = k;
+    if( n > inMaxSteps ) {
+        n = inMaxSteps;
+        }
+    for( int i=0; i<n; i++ ) {
+        outDX[i] = bx[ k - 1 - i ];
+        outDY[i] = by[ k - 1 - i ];
+        }
+    return n;
+    }
+
+
+static void npcWalkToward( LiveObject *p, NpcLink *inSock,
+                           int inTX, int inTY, int inGoalDist ) {
+    int dx[ 12 ], dy[ 12 ];
+    int steps = npcFindPath( p->xd, p->yd, inTX, inTY, inGoalDist, 8, dx, dy );
+    if( steps == 0 ) {
+        return;
+        }
+    int seq = p->lastMoveSequenceNumber + 1;
+    if( seq < 2 ) {
+        seq = 2;
+        }
+    SimpleVector<char> cmd;
+    char *head = autoSprintf( "MOVE %d %d @%d", 
+                              p->xd - p->birthPos.x, p->yd - p->birthPos.y, 
+                              seq );
+    cmd.appendElementString( head );
+    delete [] head;
+    for( int i=0; i<steps; i++ ) {
+        char *s = autoSprintf( " %d %d", dx[i], dy[i] );
+        cmd.appendElementString( s );
+        delete [] s;
+        }
+    char *c = cmd.getElementString();
+    inSock->queueCommand( c );
+    delete [] c;
+    }
+
+
+static char npcIsFoodSource( int inID, char *outPickup ) {
+    if( inID <= 0 ) {
+        return false;
+        }
+    ObjectRecord *o = getObject( inID );
+    if( o == NULL ) {
+        return false;
+        }
+    // bare hand picks it up, and what we get is edible
+    TransRecord *t = getTrans( 0, inID );
+    if( t != NULL && t->newActor > 0 ) {
+        ObjectRecord *n = getObject( t->newActor );
+        if( n != NULL && n->foodValue > 0 ) {
+            *outPickup = true;
+            return true;
+            }
+        }
+    if( t == NULL && o->foodValue > 0 && ! o->permanent ) {
+        *outPickup = true;
+        return true;
+        }
+    return false;
+    }
+
+
+static void npcThink( LiveObject *p, NpcBrain *b ) {
+    NpcLink *sock = b->link;
+    if( sock == NULL || p->heldByOther || p->dying ) {
+        return;
+        }
+    double now = Time::getCurrentTime();
+
+    // still walking?
+    if( ( p->xd != p->xs || p->yd != p->ys ) &&
+        now < p->moveStartTime + p->moveTotalSeconds + 0.2 ) {
+        return;
+        }
+
+    int rx = p->xd - p->birthPos.x;
+    int ry = p->yd - p->birthPos.y;
+
+    int cap = computeFoodCapacity( p );
+    char hungry = p->foodStore < cap - 4;
+
+    // is there a hungry little one in our family to feed?
+    LiveObject *kid = NULL;
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( o->error || o->dying || o->parentID != b->momID ) {
+            continue;
+            }
+        if( computeAge( o ) < 3 && o->foodStore < computeFoodCapacity( o ) - 2 ) {
+            kid = o;
+            break;
+            }
+        }
+
+    char holdingFood = false;
+    if( p->holdingID > 0 ) {
+        ObjectRecord *h = getObject( p->holdingID );
+        holdingFood = ( h != NULL && h->foodValue > 0 );
+        }
+
+    // 1. feed the kid, kid comes first
+    if( kid != NULL && holdingFood ) {
+        int kx = kid->xd, ky = kid->yd;
+        if( npcCheb( kx - p->xd, ky - p->yd ) <= 1 ) {
+            char *c = autoSprintf( "UBABY %d %d -1", 
+                                   kx - p->birthPos.x, ky - p->birthPos.y );
+            sock->queueCommand( c );
+            delete [] c;
+            }
+        else {
+            npcWalkToward( p, sock, kx, ky, 1 );
+            }
+        b->nextThink = now + 1.0;
+        return;
+        }
+
+    // 2. eat if hungry
+    if( hungry && holdingFood ) {
+        char *c = autoSprintf( "SELF %d %d 0", rx, ry );
+        sock->queueCommand( c );
+        delete [] c;
+        b->nextThink = now + 1.0;
+        return;
+        }
+
+    // 3. get food if someone needs it
+    if( ( hungry || kid != NULL ) && p->holdingID == 0 ) {
+        int bestD = 9999, bx = 0, by = 0;
+        for( int y = p->yd - 7; y <= p->yd + 7; y++ ) {
+            for( int x = p->xd - 7; x <= p->xd + 7; x++ ) {
+                char pickup;
+                if( npcIsFoodSource( getMapObject( x, y ), &pickup ) ) {
+                    int d = abs( x - p->xd ) + abs( y - p->yd );
+                    if( d < bestD ) {
+                        bestD = d; bx = x; by = y;
+                        }
+                    }
+                }
+            }
+        if( bestD < 9999 ) {
+            if( npcCheb( bx - p->xd, by - p->yd ) <= 1 ) {
+                char *c = autoSprintf( "USE %d %d", 
+                                       bx - p->birthPos.x, 
+                                       by - p->birthPos.y );
+                sock->queueCommand( c );
+                delete [] c;
+                }
+            else {
+                npcWalkToward( p, sock, bx, by, 1 );
+                }
+            b->nextThink = now + 1.0;
+            return;
+            }
+        }
+
+    // 4. holding something useless?  put it down if the ground is free.
+    if( p->holdingID > 0 && ! holdingFood && 
+        getMapObject( p->xd, p->yd ) == 0 ) {
+        char *c = autoSprintf( "DROP %d %d -1", rx, ry );
+        sock->queueCommand( c );
+        delete [] c;
+        b->nextThink = now + 1.5;
+        return;
+        }
+
+    // 5. chatter now and then
+    if( now > b->nextSay ) {
+        const char *lines[5] = { "HELLO", "NICE DAY", "STAY CLOSE", 
+                                 "WE ARE FAMILY", "LOVE YOU" };
+        char *c = autoSprintf( "SAY 0 0 %s", 
+                               lines[ randSource.getRandomBoundedInt( 0, 4 ) ] );
+        sock->queueCommand( c );
+        delete [] c;
+        b->nextSay = now + 30 + randSource.getRandomBoundedInt( 0, 40 );
+        }
+
+    // 6. otherwise stroll near home, or follow the mother if father
+    if( randSource.getRandomBoundedInt( 0, 2 ) == 0 ) {
+        int hx = b->homeX, hy = b->homeY;
+        if( b->role == 1 ) {
+            LiveObject *mom = getLiveObject( b->momID );
+            if( mom != NULL ) {
+                hx = mom->xd; hy = mom->yd;
+                }
+            }
+        int tx = hx + randSource.getRandomBoundedInt( -6, 6 );
+        int ty = hy + randSource.getRandomBoundedInt( -6, 6 );
+        npcWalkToward( p, sock, tx, ty, 0 );
+        }
+    b->nextThink = now + 2 + randSource.getRandomBoundedInt( 0, 2 );
+    }
+
+
+static void npcTick() {
+    double now = Time::getCurrentTime();
+
