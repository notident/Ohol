+    Socket *sock = link->takeServerSocket();
+    SimpleVector<char> *buffer = new SimpleVector<char>();
+
+    CurseStatus cs = { 0, 0 };
+    PastLifeStats ls;
+    ls.lifeCount = 10;
+    ls.lifeTotalSeconds = 100000;
+    ls.accountExistedDays = 100;
+
