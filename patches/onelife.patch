+// picks a random person object of the wanted gender, or -1
+static int npcPickDisplayID( char inWantFemale ) {
+    for( int t=0; t<200; t++ ) {
+        int id = getRandomPersonObject();
+        ObjectRecord *o = getObject( id );
+        if( o != NULL && o->person && ( o->male != inWantFemale ) ) {
+            return id;
+            }
+        }
+    return -1;
+    }
+
+
+// returns new player ID or -1
