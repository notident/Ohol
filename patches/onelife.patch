+#ifndef NPC_LINK_INCLUDED
+#define NPC_LINK_INCLUDED
+
+#include "minorGems/network/Socket.h"
+
+
+// A connection between the server and a server-side AI player.
+//
+// Internally an OS socket pair.  One end is wrapped in a normal minorGems
+// Socket that the server uses like any client connection.  We keep the
+// other end and type client commands into it, so the NPC goes through
+// the normal message handling (path checks, transitions, hunger...).
+class NpcLink {
+    public:
+        NpcLink();
+        ~NpcLink();
+
+        // true if the socket pair was created
+        char isOK() { return mOK; }
+
+        // the server-side Socket.  Ownership goes to the server
+        // (it deletes it when the player is removed).
+        Socket *takeServerSocket();
+
+        // inCommand without the trailing '#', for example "SELF 0 0 0"
+        void queueCommand( const char *inCommand );
+
+        // throw away anything the server sent us, so buffers never fill up
+        void drain();
+
+    protected:
+        int mFD;            // our end
+        int mServerFD;
+        char mOK;
+        char mServerSideTaken;
+    };
+
+#endif
