+static int spawnNpc( int inRole, int inMomID, GridPos *inPos ) {
+    npcSpawnCounter++;
+
+    char *email = autoSprintf( "npc_%d_%d@npc.local", 
+                               inRole, npcSpawnCounter );
+    NpcLink *link = new NpcLink();
+    if( ! link->isOK() ) {
+        delete link;
+        delete [] email;
+        return -1;
