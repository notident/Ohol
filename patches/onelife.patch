+typedef struct NpcBrain {
+        int id;
+        int role;           // 0 = mother, 1 = father
+        int momID;          // who the family's mother is
+        double nextThink;
+        double nextSay;
+        int homeX, homeY;
+        NpcLink *link;
+    } NpcBrain;
+
+static SimpleVector<NpcBrain> npcBrains;
+static int npcSpawnCounter = 0;
+
+
+static NpcBrain *getNpcBrain( int inID ) {
+    for( int i=0; i<npcBrains.size(); i++ ) {
+        NpcBrain *b = npcBrains.getElement( i );
+        if( b->id == inID ) {
+            return b;
+            }
+        }
+    return NULL;
+    }
