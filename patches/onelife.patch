+static LiveObject *findLiveNpcWithRole( int inRole ) {
+    for( int i=0; i<players.size(); i++ ) {
+        LiveObject *o = players.getElement( i );
+        if( ! o->error && ! o->dying ) {
+            NpcBrain *b = getNpcBrain( o->id );
+            if( b != NULL && b->role == inRole ) {
+                return o;
+                }
+            }
+        }
+    return NULL;
+    }
