+#include "npc.h"
+
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/types.h>
+#include <sys/socket.h>
+
+
+NpcLink::NpcLink()
+        : mFD( -1 ), mServerFD( -1 ), mOK( false ), mServerSideTaken( false ) {
+    int fds[2];
+    if( socketpair( AF_UNIX, SOCK_STREAM, 0, fds ) == 0 ) {
+        mServerFD = fds[0];
+        mFD = fds[1];
+        fcntl( mFD, F_SETFL, O_NONBLOCK );
+        mOK = true;
+        }
+    }
+
+
+NpcLink::~NpcLink() {
+    if( mFD != -1 ) {
+        close( mFD );
+        }
+    if( ! mServerSideTaken && mServerFD != -1 ) {
+        close( mServerFD );
+        }
+    }
+
+
+Socket *NpcLink::takeServerSocket() {
+    Socket *s = new Socket();
+    s->mNativeSocketID = mServerFD;
+    mServerSideTaken = true;
+    return s;
+    }
+
+
+void NpcLink::queueCommand( const char *inCommand ) {
+    if( mFD == -1 ) {
+        return;
+        }
+    int len = strlen( inCommand );
+    char *msg = new char[ len + 1 ];
+    memcpy( msg, inCommand, len );
+    msg[len] = '#';
+    // commands are tiny, so one send either goes out whole or not at all
+    send( mFD, msg, len + 1, MSG_NOSIGNAL );
+    delete [] msg;
+    }
+
+
+void NpcLink::drain() {
+    if( mFD == -1 ) {
+        return;
+        }
+    char junk[4096];
+    while( recv( mFD, junk, sizeof( junk ), 0 ) > 0 ) {
+        }
+    }
